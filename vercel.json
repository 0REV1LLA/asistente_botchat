{
    "builds": [
        {
            "src": "asistente_virtual/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "runtime": "python3.12",
                "installCommand": "bash vercel-start.sh"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "asistente_virtual/wsgi.py"
        }
    ]
}
