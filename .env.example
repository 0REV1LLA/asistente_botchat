SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Email local: con DEBUG=True se usa la consola de Django.
# En producción usa DEBUG=False y configura SMTP (en Vercel, como Environment Variables).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
PUBLIC_URL=http://127.0.0.1:8000

# Default portable mode (DESACTIVADO)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# original database (ACTIVADO)
DB_ENGINE=django.db.backends.mysql
DB_NAME=inventario_farmaluz
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
